/*
 * emocar — a face on the car that reacts to how it moves.
 * ESP32-C3 Super Mini + L3G4200D (GY-50) gyro + SH1106 128x64 OLED, one I2C bus.
 *
 *   In a hand:   HAPPY 🥰 — always. Being held is the answer; nothing overrides it.
 *   On a surface: NORMAL 🙂 default
 *                 FAST   😮 3-axis vibration RMS above FAST_ENTER_RMS
 *                 DIZZY  🥴 a spin (|gz| holding one sign) + wooze ∝ degrees spun
 *   A context bit decides which of those two worlds applies, from roll travel a car on
 *   wheels cannot produce. Deciding the situation first is what makes the thresholds
 *   tractable: FAST and DIZZY only ever have to describe a car on a surface.
 *
 * Files:
 *   config.h     every pin, address, rate and threshold — edit here only
 *   gyro.*       L3G4200D register driver, FIFO stream mode      (same as ../L3G4200D)
 *   motion.*     bias correction, vibration RMS, state machine    (same as ../L3G4200D)
 *   display.*    panel driver behind a 3-call API — the display profile lives in config.h
 *                (DISP_*, must match server/profiles.json); new monitor = new backend here
 *   anim.*       non-blocking .qgif player, one animation per state
 *                (LittleFS /anim<N>.qgif when uploaded, else the PROGMEM placeholder)
 *   anim_data.h  generated by mkanim.py — faces, index 0/1/2/3 = NORMAL/FAST/DIZZY/HAPPY
 *   cmd.*        command protocol on the USB serial port; the Go server in server/
 *                pushes .qgif blobs over the cable
 *
 * Wiring (see wiring.md):
 *   GY-50 VCC -> 3V3      SH1106 VCC -> 3V3
 *   GY-50 GND -> GND      SH1106 GND -> GND
 *   GY-50 SCL -> GPIO9    SH1106 SCL -> GPIO9
 *   GY-50 SDA -> GPIO8    SH1106 SDA -> GPIO8
 *   GY-50 SDO/CS/INT1/INT2 left open  (SDO open -> address 0x69)
 *
 * Flow:
 *   1. Probe gyro, check WHO_AM_I, configure ODR / full scale / BDU.
 *      A gyro that does not answer shows GYRO ERROR and is retried every GYRO_RETRY_MS.
 *   2. Zero-rate bias over CALIB_MS — car on the floor, not held (it shows "CALIBRATING").
 *      Taps and bumps are tolerated; being picked up or turned makes it wait.
 *   3. Enable FIFO: the chip samples every SAMPLE_US exactly; the loop drains bursts.
 *   4. Per sample: motionUpdate(). On state change: animShow(). Every loop: animTick().
 *
 * Thresholds come from ../L3G4200D (telemetry screen). Retune there, copy into config.h.
 */

#include <Arduino.h>
#include <Wire.h>
#include <LittleFS.h>
#include "config.h"
#include "gyro.h"
#include "motion.h"
#include "anim.h"
#include "cmd.h"

// Bring the gyro up at boot, retrying every GYRO_RETRY_MS until it answers. This used to
// halt(), which turned a jostled wire — or a chip that missed the first boot after a flash,
// seen on the bench — into a manual reset after the wire was reseated. Same policy as the
// runtime watchdog: say what is wrong, keep trying, come back by itself. The reason is
// re-printed on every retry, so a terminal opened after boot still sees why.
static void gyroUp() {
  for (int attempt = 1; ; attempt++) {
    uint8_t who;
    GyroError e = gyroBegin(who);
    Serial.printf("WHO_AM_I = 0x%02X\n", who);
    if (e == GYRO_OK) {
      if (attempt > 1) Serial.println("! gyro recovered");
      return;
    }
    char l2[24]; snprintf(l2, sizeof l2, "got 0x%02X", who);
    Serial.printf("! gyro: %s (got 0x%02X) — retry %d in %d ms\n",
                  gyroErrorText(e), who, attempt, GYRO_RETRY_MS);
    animMessage("GYRO ERROR", gyroErrorText(e), l2);
    delay(GYRO_RETRY_MS);
  }
}

// Zero-rate bias from a rolling window of CALIB_BLOCKS short blocks (CALIB_* in config.h).
//
// A bias measured while the car is being turned is silently poisoned — the offset is baked
// in and every later reading carries it, so the car can sit motionless reading 18 dps and
// never return to NORMAL. But a tap or a rumble is not that: it rattles without turning,
// and the old all-samples-steady test threw the whole window away over it. Now each block
// is averaged and the bias comes from the blocks that agree (motionCalibFit), so a tap is
// outvoted, and only a hand — whose blocks never agree — keeps it waiting. The window rolls
// one block at a time, so the car calibrates as soon as the last CALIB_MS looks right.
//
// Returns false if the gyro delivers no samples at all (answering on I2C is not the same
// as producing data — a wedged chip does the one without the other); the caller re-inits.
static bool calibrate() {
  const float k = gyroSensitivity();
  Serial.println("Calibrating bias — keep still...");

  float blk[CALIB_BLOCKS][3];
  bool waiting = false;
  for (int b = 0; ; b++) {
    long sx = 0, sy = 0, sz = 0; int n = 0;
    uint32_t t0 = millis();
    while (millis() - t0 < CALIB_BLOCK_MS) {
      GyroRaw r;
      if (gyroDataReady() && gyroReadRaw(r)) { sx += r.x; sy += r.y; sz += r.z; n++; }
      delay(2);
    }
    if (n == 0) {
      Serial.println("! gyro answers but delivers no samples — check wiring (SDA 8 / SCL 9)");
      animMessage("GYRO ERROR", "no data", "check wiring");
      return false;
    }
    if (b == 0) animMessage("CALIBRATING", "keep still", "");   // only once data is flowing
    float *e = blk[b % CALIB_BLOCKS];
    e[0] = sx * k / n; e[1] = sy * k / n; e[2] = sz * k / n;
    if (b + 1 < CALIB_BLOCKS) continue;          // window not full yet

    float bias[3]; int agree;
    if (motionCalibFit(blk, CALIB_BLOCKS, bias, agree)) {
      motionSetBias(bias[0], bias[1], bias[2]);
      Serial.printf("Bias: X=%.2f Y=%.2f Z=%.2f dps (%d/%d blocks agree)\n",
                    bias[0], bias[1], bias[2], agree, CALIB_BLOCKS);
      return true;
    }
    if (!waiting) { animMessage("CALIBRATING", "keep still", "moving - waiting"); waiting = true; }
    if ((b + 1) % CALIB_BLOCKS == 0)             // once per window, not every block
      Serial.printf("! car is being turned (%d/%d blocks agree, need %d) — waiting\n",
                    agree, CALIB_BLOCKS, CALIB_MIN_AGREE);
  }
}

static void printTelemetry(const Motion &m) {
  Serial.printf("%8.1f %8.1f %8.1f | rms %6.1f pk %6.1f | jit %5.1f | gz pk %6.1f | roll %6.1f %s | %4lu sps | %s\n",
                m.gx, m.gy, m.gz, m.rms, m.rmsPeak, m.jitter, m.gzPeak,
                m.rollAcc, m.handCtx ? "HAND " : "floor",
                (unsigned long)m.sampleRate, carStateName(m.state));
}

void setup() {
  Serial.begin(SERIAL_BAUD);
  // The driver's RX queue silently drops what doesn't fit, and the stock 256 bytes is
  // less than one upload chunk — see cmd.cpp.
  Serial.setRxBufferSize(CMD_RX_BUF);
  Serial.setTxTimeoutMs(0);        // never block the loop when no terminal is reading USB CDC
  delay(300);

  Wire.begin(PIN_SDA, PIN_SCL);
  Wire.setClock(I2C_HZ);

  if (!LittleFS.begin(true))             // true = format on first mount
    Serial.println("! LittleFS mount failed — placeholder animations only");

  animBegin();
  animMessage("emocar", "USB anim upload", "SDA 8 / SCL 9");
  delay(500);

  Serial.println("\nemocar bring-up");
  Serial.printf("Sample period %d us (%d Hz), RMS window %d samples\n",
                SAMPLE_US, 1000000 / SAMPLE_US, RMS_WINDOW);

  for (;;) {                       // never halt: a dead gyro at boot is retried, not fatal
    gyroUp();
    if (calibrate()) break;
    delay(GYRO_RETRY_MS);
  }
  motionReset();
  gyroFifoEnable();
  animShow(motionGet().state);
  Serial.println("Running. Columns: gx gy gz | rms pk | jitter | gz pk | roll ctx | samples/s | state");
}

// A gyro that stops delivering leaves the last state frozen on screen — a stale face is
// worse than an error, because it looks like a feeling. Nothing in the sample data can
// reveal this (a wedged sensor reads as perfectly still), so the only test is whether new
// samples are arriving at all. Recovery is attempted forever rather than halting: the fault
// is usually a jostled wire, and the car should come back by itself when it is reseated.
static void gyroWatchdog(int n, uint32_t now) {
  static uint32_t lastSample = 0, lastRetry = 0;
  static bool lost = false;

  if (n > 0) {
    lastSample = now;
    if (lost) {                                  // it came back
      lost = false;
      Serial.println("! gyro recovered");
      animShow(motionGet().state);
    }
    return;
  }
  if (!lastSample) lastSample = now;             // first loop, nothing has arrived yet
  if (!lost && now - lastSample > GYRO_TIMEOUT_MS) {
    lost = true; lastRetry = now;
    Serial.println("! gyro stopped delivering samples — check wiring (SDA 8 / SCL 9)");
    animMessage("GYRO ERROR", "no data", "check wiring");
  }
  if (lost && now - lastRetry >= GYRO_RETRY_MS) {
    lastRetry = now;
    uint8_t who;
    if (gyroBegin(who) == GYRO_OK) { gyroFifoEnable(); Serial.println("re-init ok, waiting for samples"); }
    else Serial.printf("re-init failed (WHO_AM_I 0x%02X)\n", who);
  }
}

void loop() {
  static uint32_t lastPrint = 0;

  GyroRaw fifo[21]; bool overrun;
  int n = gyroReadFifo(fifo, 21, overrun);
  if (overrun) Serial.println("! FIFO overrun — loop too slow, samples lost");
  gyroWatchdog(n, millis());
  for (int i = 0; i < n; i++)
    if (motionUpdate(fifo[i])) {
      Serial.printf(">>> state = %s\n", carStateName(motionGet().state));
      animShow(motionGet().state);
    }
  motionTick();
  animTick();
  cmdPoll();

  if (PRINT_MS && millis() - lastPrint >= PRINT_MS) { lastPrint = millis(); printTelemetry(motionGet()); }
}
