/*
 * emocar — a face on the car that reacts to how it moves.
 * ESP32-C3 Super Mini + L3G4200D (GY-50) gyro + SH1106 128x64 OLED, one I2C bus.
 *
 *   In a hand:    HAPPY 🥰
 *   On a surface: NORMAL 🙂 default
 *                 FAST   😮 sustained vibration
 *                 DIZZY  🥴 a spin, then wooze ∝ degrees spun
 *   Only states registered in config.h (STATE_*) are shown. With NORMAL alone the gyro
 *   is never started (USE_GYRO).
 *
 * Files:
 *   config.h     every pin, address, rate and threshold
 *   gyro.*       L3G4200D register driver, FIFO stream mode
 *   motion.*     bias correction, vibration RMS, state machine
 *   display.*    panel driver behind a 3-call API
 *   anim.*       non-blocking .qgif player, one animation per state
 *   anim_data.h  generated by mkanim.py — placeholder faces
 *   cmd.*        USB serial command protocol for the Go server in server/
 *
 * Wiring: see wiring.md. GY-50 and SH1106 share 3V3/GND, SDA GPIO8, SCL GPIO9.
 * Design notes: README.md.
 */

#include <Arduino.h>
#include <Wire.h>
#include <LittleFS.h>
#include "config.h"
#include "gyro.h"
#include "motion.h"
#include "anim.h"
#include "cmd.h"

static void showNoData() { animMessage("GYRO ERROR", "no data", "check wiring"); }

// Bring the gyro up, retrying every GYRO_RETRY_MS until it answers.
static void gyroUp() {
  for (;;) {
    uint8_t who;
    GyroError e = gyroBegin(who);
    if (e == GYRO_OK) return;
    char l2[24]; snprintf(l2, sizeof l2, "got 0x%02X", who);
    animMessage("GYRO ERROR", gyroErrorText(e), l2);
    delay(GYRO_RETRY_MS);
  }
}

// Zero-rate bias from a rolling window of CALIB_BLOCKS blocks (see motionCalibFit).
// Returns false if the gyro answers but delivers no samples; the caller re-inits.
static bool calibrate() {
  const float k = gyroSensitivity();
  float blk[CALIB_BLOCKS][3];
  bool waiting = false;
  for (int b = 0; ; b++) {
    long sx = 0, sy = 0, sz = 0; int n = 0;
    uint32_t t0 = millis();
    while (millis() - t0 < CALIB_BLOCK_MS) {
      GyroRaw r;
      if (gyroDataReady() && gyroReadRaw(r)) { sx += r.x; sy += r.y; sz += r.z; n++; }
      delay(2);
    }
    if (n == 0) { showNoData(); return false; }
    if (CALIB_UI && b == 0) animMessage("CALIBRATING", "keep still", "");
    float *e = blk[b % CALIB_BLOCKS];
    e[0] = sx * k / n; e[1] = sy * k / n; e[2] = sz * k / n;
    if (b + 1 < CALIB_BLOCKS) continue;          // window not full yet

    float bias[3]; int agree;
    if (motionCalibFit(blk, CALIB_BLOCKS, bias, agree)) {
      motionSetBias(bias[0], bias[1], bias[2]);
      return true;
    }
    if (CALIB_UI && !waiting) animMessage("CALIBRATING", "keep still", "moving - waiting");
    waiting = true;
  }
}

void setup() {
  Serial.begin(SERIAL_BAUD);
  Serial.setRxBufferSize(CMD_RX_BUF);
  Serial.setTxTimeoutMs(0);        // never block the loop when no terminal is reading
  delay(300);

  Wire.begin(PIN_SDA, PIN_SCL);
  Wire.setClock(I2C_HZ);
  LittleFS.begin(true);            // true = format on first mount; on failure placeholders play

  animBegin();
  animMessage("emocar", "USB anim upload", "SDA 8 / SCL 9");
  delay(500);

  if (USE_GYRO) {
    for (;;) {
      gyroUp();
      if (calibrate()) break;
      delay(GYRO_RETRY_MS);
    }
  }

  motionReset();
  if (USE_GYRO) gyroFifoEnable();
  animShow(motionGet().state);
}

// A gyro that stops delivering would freeze the last face on screen, and its data alone
// can't show it (a wedged sensor reads as still). Show an error and retry forever.
static void gyroWatchdog(int n, uint32_t now) {
  static uint32_t lastSample = 0, lastRetry = 0;
  static bool lost = false;

  if (n > 0) {
    lastSample = now;
    if (lost) {
      lost = false;
      animShow(motionGet().state);
    }
    return;
  }
  if (!lastSample) lastSample = now;             // nothing has arrived yet
  if (!lost && now - lastSample > GYRO_TIMEOUT_MS) {
    lost = true; lastRetry = now;
    showNoData();
  }
  if (lost && now - lastRetry >= GYRO_RETRY_MS) {
    lastRetry = now;
    uint8_t who;
    if (gyroBegin(who) == GYRO_OK) gyroFifoEnable();
  }
}

static void pollGyro() {
  GyroRaw fifo[GYRO_FIFO_MAX_READ]; bool overrun;
  int n = gyroReadFifo(fifo, GYRO_FIFO_MAX_READ, overrun);
  gyroWatchdog(n, millis());
  for (int i = 0; i < n; i++)
    if (motionUpdate(fifo[i])) animShow(motionGet().state);
}

void loop() {
  if (USE_GYRO) pollGyro();
  animTick();
  cmdPoll();
}
