/*
 * emocar — a face on the car that reacts to how it moves.
 * ESP32-C3 Super Mini + L3G4200D (GY-50) gyro + SH1106 128x64 OLED, one I2C bus.
 *
 *   Shaken / spun:  DIZZY 🥴 (any axis shake, gz spin; in a hand or not), 2 s after
 *   In a hand:    HAPPY 🥰
 *   On a surface: NORMAL 🙂 default
 *                 FAST   😮 sustained vibration
 *   Only states switched on are shown: STATE_* in config.h, changeable live from the
 *   server's /configs page (cfg.*). With NORMAL alone the gyro is never started.
 *
 * Files:
 *   config.h     every pin, address, rate and threshold
 *   gyro.*       L3G4200D register driver, FIFO stream mode
 *   motion.*     bias correction, vibration RMS, state machine
 *   cfg.*        the state conditions at runtime, saved on flash
 *   display.*    panel driver behind a 3-call API
 *   anim.*       non-blocking .qgif player, one animation per state
 *   anim_data.h  generated by mkanim.py — placeholder faces
 *   cmd.*        USB serial command protocol for the Go server in server/
 *   telem.*      live sensor line + orientation for the server's /dashboard
 *
 * Wiring: see wiring.md. GY-50 and SH1106 share 3V3/GND, SDA GPIO8, SCL GPIO9.
 * Design notes: DESIGN.md.
 */

#include <Arduino.h>
#include <Wire.h>
#include <LittleFS.h>
#include "config.h"
#include "gyro.h"
#include "motion.h"
#include "cfg.h"
#include "anim.h"
#include "cmd.h"
#include "telem.h"

#define DBG(...) do { if (DEBUG_LOG) Serial.printf(__VA_ARGS__); } while (0)

static bool gyroOn;                // decided at boot from the saved config

static void showNoData() {
  DBG("gyro: no samples — check wiring (SDA 8 / SCL 9)\n");
  animMessage("GYRO ERROR", "no data", "check wiring");
}

// Bring the gyro up, retrying every GYRO_RETRY_MS until it answers.
static void gyroUp() {
  for (;;) {
    uint8_t who;
    GyroError e = gyroBegin(who);
    if (e == GYRO_OK) { DBG("gyro: ok (WHO_AM_I 0x%02X)\n", who); return; }
    DBG("gyro: %s (got 0x%02X), retry in %d ms\n", gyroErrorText(e), who, GYRO_RETRY_MS);
    char l2[24]; snprintf(l2, sizeof l2, "got 0x%02X", who);
    animMessage("GYRO ERROR", gyroErrorText(e), l2);
    delay(GYRO_RETRY_MS);
  }
}

// Zero-rate bias from a rolling window of CALIB_BLOCKS blocks (see motionCalibFit).
// Returns false if the gyro answers but delivers no samples; the caller re-inits.
static bool calibrate() {
  const float k = gyroSensitivity();
  DBG("calib: keep still...\n");
  float blk[CALIB_BLOCKS][3];
  bool waiting = false;
  for (int b = 0; ; b++) {
    long sx = 0, sy = 0, sz = 0; int n = 0;
    uint32_t t0 = millis();
    while (millis() - t0 < CALIB_BLOCK_MS) {
      GyroRaw r;
      if (gyroDataReady() && gyroReadRaw(r)) { sx += r.x; sy += r.y; sz += r.z; n++; }
      delay(2);
    }
    if (n == 0) { showNoData(); return false; }
    if (CALIB_UI && b == 0) animMessage("CALIBRATING", "keep still", "");
    float *e = blk[b % CALIB_BLOCKS];
    e[0] = sx * k / n; e[1] = sy * k / n; e[2] = sz * k / n;
    if (b + 1 < CALIB_BLOCKS) continue;          // window not full yet

    float bias[3]; int agree;
    if (motionCalibFit(blk, CALIB_BLOCKS, bias, agree)) {
      motionSetBias(bias[0], bias[1], bias[2]);
      DBG("calib: bias %.2f %.2f %.2f dps (%d/%d blocks agree)\n",
          bias[0], bias[1], bias[2], agree, CALIB_BLOCKS);
      return true;
    }
    if (CALIB_UI && !waiting) animMessage("CALIBRATING", "keep still", "moving - waiting");
    waiting = true;
    if ((b + 1) % CALIB_BLOCKS == 0)             // once per window
      DBG("calib: car is moving (%d/%d blocks agree, need %d), waiting\n",
          agree, CALIB_BLOCKS, CALIB_MIN_AGREE);
  }
}

void setup() {
  Serial.begin(SERIAL_BAUD);
  Serial.setRxBufferSize(CMD_RX_BUF);
  Serial.setTxTimeoutMs(0);        // never block the loop when no terminal is reading
  delay(300);

  Wire.begin(PIN_SDA, PIN_SCL);
  Wire.setClock(I2C_HZ);
  LittleFS.begin(true);            // true = format on first mount; on failure placeholders play

  animBegin();
  cfgLoad();
  gyroOn = cfgAnyState(cfg);
  DBG("\nemocar: states NORMAL%s%s%s, gyro %s\n", cfg.stateFast ? " FAST" : "",
      cfg.stateDizzy ? " DIZZY" : "", cfg.stateHappy ? " HAPPY" : "", gyroOn ? "on" : "off");

  if (gyroOn) {
    for (;;) {
      gyroUp();
      if (calibrate()) break;
      delay(GYRO_RETRY_MS);
    }
  }

  motionReset();
  if (gyroOn) gyroFifoEnable();
  animShow(motionGet().state);
  DBG("running — columns: gx gy gz | peak |gx| |gy| |gz| | rms | ctx roll | swings spin-ms | state\n");
}

// A gyro that stops delivering would freeze the last face on screen, and its data alone
// can't show it (a wedged sensor reads as still). Show an error and retry forever.
static void gyroWatchdog(int n, uint32_t now) {
  static uint32_t lastSample = 0, lastRetry = 0;
  static bool lost = false;

  if (n > 0) {
    lastSample = now;
    if (lost) {
      lost = false;
      DBG("gyro: recovered\n");
      animShow(motionGet().state);
    }
    return;
  }
  if (!lastSample) lastSample = now;             // nothing has arrived yet
  if (!lost && now - lastSample > GYRO_TIMEOUT_MS) {
    lost = true; lastRetry = now;
    showNoData();
  }
  if (lost && now - lastRetry >= GYRO_RETRY_MS) {
    lastRetry = now;
    uint8_t who;
    if (gyroBegin(who) == GYRO_OK) gyroFifoEnable();
    else DBG("gyro: re-init failed (WHO_AM_I 0x%02X)\n", who);
  }
}

// Peaks since the last debug line, so a quick swing between two lines still shows.
static float pkX, pkY, pkZ;

static void printDebugLine() {
  static uint32_t lastPrint = 0;
  if (!DEBUG_LOG || millis() - lastPrint < DEBUG_PRINT_MS) return;
  lastPrint = millis();
  const Motion &m = motionGet();
  DBG("%7.1f %7.1f %7.1f | pk %6.1f %6.1f %6.1f | rms %6.1f | %s %5.1f | %d/%d/%d %5lu | %s\n",
      m.gx, m.gy, m.gz, pkX, pkY, pkZ, m.rms, m.handCtx ? "HAND " : "floor", m.rollAcc,
      m.swings[0], m.swings[1], m.swings[2], (unsigned long)m.spinMs, carStateName(m.state));
  pkX = pkY = pkZ = 0;
}

static void pollGyro() {
  GyroRaw fifo[GYRO_FIFO_MAX_READ]; bool overrun;
  int n = gyroReadFifo(fifo, GYRO_FIFO_MAX_READ, overrun);
  if (overrun) DBG("gyro: FIFO overrun, samples lost\n");
  gyroWatchdog(n, millis());
  for (int i = 0; i < n; i++) {
    CarState was = motionGet().state;
    bool changed = motionUpdate(fifo[i]);
    const Motion &m = motionGet();
    telemSample(m);
    pkX = fmaxf(pkX, fabsf(m.gx)); pkY = fmaxf(pkY, fabsf(m.gy)); pkZ = fmaxf(pkZ, fabsf(m.gz));
    if (changed) {
      DBG(">>> %s -> %s\n", carStateName(was), carStateName(m.state));
      animShow(m.state);
    }
  }
  printDebugLine();
  telemPoll();
}

void loop() {
  if (gyroOn) pollGyro();
  animTick();
  cmdPoll();
  // A state switched on from /configs while the car runs NORMAL-only: the gyro was never
  // calibrated, so boot again and let setup() do it. The CFG reply is out first.
  if (!gyroOn && cfgAnyState(cfg)) {
    Serial.flush();
    delay(100);
    ESP.restart();
  }
}
