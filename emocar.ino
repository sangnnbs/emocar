/*
 * emocar — a face on the car that reacts to how it moves.
 * ESP32-C3 Super Mini + L3G4200D (GY-50) gyro + SH1106 128x64 OLED, one I2C bus.
 *
 *   NORMAL 🙂  default
 *   FAST   😮  3-axis vibration RMS above FAST_ENTER_RMS — floor only
 *   DIZZY  🥴  a spin (|gz| one sign) or a hard shake (RMS), plus the wooze it earned
 *   HAPPY  🥰  someone picked the car up — the context bit, not a threshold
 *   Priority DIZZY > HAPPY > FAST > NORMAL, hysteresis + hold time — see config.h.
 *   FAST and HAPPY are separated by situation, not magnitude: a hand and a push across
 *   a desk shake the gyro about equally, so a context bit decides which one applies.
 *
 * Files:
 *   config.h     every pin, address, rate and threshold — edit here only
 *   gyro.*       L3G4200D register driver, FIFO stream mode      (same as ../L3G4200D)
 *   motion.*     bias correction, vibration RMS, state machine    (same as ../L3G4200D)
 *   display.*    panel driver behind a 3-call API — the display profile lives in config.h
 *                (DISP_*, must match server/profiles.json); new monitor = new backend here
 *   anim.*       non-blocking .qgif player, one animation per state
 *                (LittleFS /anim<N>.qgif when uploaded, else the PROGMEM placeholder)
 *   anim_data.h  generated by mkanim.py — faces, index 0/1/2/3 = NORMAL/FAST/DIZZY/HAPPY
 *   net.*        WiFi hotspot + HTTP endpoint; the Go server in server/ pushes .qgif blobs
 *
 * Wiring (see wiring.md):
 *   GY-50 VCC -> 3V3      SH1106 VCC -> 3V3
 *   GY-50 GND -> GND      SH1106 GND -> GND
 *   GY-50 SCL -> GPIO9    SH1106 SCL -> GPIO9
 *   GY-50 SDA -> GPIO8    SH1106 SDA -> GPIO8
 *   GY-50 SDO/CS/INT1/INT2 left open  (SDO open -> address 0x69)
 *
 * Flow:
 *   1. Probe gyro, check WHO_AM_I, configure ODR / full scale / BDU.
 *   2. Average zero-rate bias for CALIB_MS — car must be STILL (it shows "CALIBRATING").
 *   3. Enable FIFO: the chip samples every SAMPLE_US exactly; the loop drains bursts.
 *   4. Per sample: motionUpdate(). On state change: animShow(). Every loop: animTick().
 *
 * Thresholds come from ../L3G4200D (telemetry screen). Retune there, copy into config.h.
 */

#include <Arduino.h>
#include <Wire.h>
#include <LittleFS.h>
#include "config.h"
#include "gyro.h"
#include "motion.h"
#include "anim.h"
#include "net.h"

static void halt(const char *why, uint8_t got) {
  char l2[24]; snprintf(l2, sizeof l2, "got 0x%02X", got);
  Serial.printf("FATAL: %s (got 0x%02X)\n", why, got);
  animMessage("GYRO ERROR", why, l2);
  while (true) delay(1000);
}

// Average CALIB_MS of polled samples while the car is still; store as bias.
//
// A bias measured while the car is moving is silently poisoned — the offset is baked in
// and every later reading carries it, so the car can sit motionless reading 18 dps and
// never return to NORMAL. So the window is only accepted if the samples were *steady*:
// jitter (spread about the mean), never the mean itself, because the mean is exactly what
// a bad bias corrupts. Below rest level it retries, showing "keep still" until it gets a
// quiet window. Two of these were caught by hand during bring-up; now the car catches them.
static void calibrate() {
  const float k = gyroSensitivity();
  Serial.println("Calibrating bias — keep still...");
  animMessage("CALIBRATING", "keep still", "");

  for (int attempt = 1; ; attempt++) {
    double sx = 0, sy = 0, sz = 0, ssq = 0; int n = 0;
    uint32_t t0 = millis();
    while (millis() - t0 < CALIB_MS) {
      GyroRaw r;
      if (gyroDataReady() && gyroReadRaw(r)) {
        float gx = r.x * k, gy = r.y * k, gz = r.z * k;
        sx += gx; sy += gy; sz += gz;
        ssq += (double)gx * gx + (double)gy * gy + (double)gz * gz;
        n++;
      }
      delay(2);
    }
    if (n == 0) halt("no samples", 0);

    float bx = sx / n, by = sy / n, bz = sz / n;
    float var = ssq / n - ((double)bx * bx + (double)by * by + (double)bz * bz);
    float jitter = var > 0 ? sqrtf(var) : 0;

    if (jitter <= REST_JITTER_DPS) {
      motionSetBias(bx, by, bz);
      Serial.printf("Bias: X=%.2f Y=%.2f Z=%.2f dps (%d samples, jitter %.2f)\n",
                    bx, by, bz, n, jitter);
      return;
    }
    Serial.printf("! moved during calibration (jitter %.1f dps > %.1f) — retry %d\n",
                  jitter, REST_JITTER_DPS, attempt);
    animMessage("CALIBRATING", "keep still", "moved - retrying");
  }
}

static void printTelemetry(const Motion &m) {
  Serial.printf("%8.1f %8.1f %8.1f | rms %6.1f pk %6.1f | jit %5.1f | gz pk %6.1f | roll %6.1f %s | %4lu sps | %s\n",
                m.gx, m.gy, m.gz, m.rms, m.rmsPeak, m.jitter, m.gzPeak,
                m.rollAcc, m.handCtx ? "HAND " : "floor",
                (unsigned long)m.sampleRate, carStateName(m.state));
}

void setup() {
  Serial.begin(SERIAL_BAUD);
  Serial.setTxTimeoutMs(0);        // never block the loop when no terminal is reading USB CDC
  delay(300);

  Wire.begin(PIN_SDA, PIN_SCL);
  Wire.setClock(I2C_HZ);

  if (!LittleFS.begin(true))             // true = format on first mount
    Serial.println("! LittleFS mount failed — placeholder animations only");
  netBegin();

  animBegin();
  animMessage("emocar", "WiFi: " WIFI_AP_SSID, "SDA 8 / SCL 9");
  delay(500);

  Serial.println("\nemocar bring-up");
  uint8_t who;
  GyroError e = gyroBegin(who);
  Serial.printf("WHO_AM_I = 0x%02X\n", who);
  if (e != GYRO_OK) halt(gyroErrorText(e), who);
  Serial.printf("Sample period %d us (%d Hz), RMS window %d samples\n",
                SAMPLE_US, 1000000 / SAMPLE_US, RMS_WINDOW);

  calibrate();
  motionReset();
  gyroFifoEnable();
  animShow(motionGet().state);
  Serial.println("Running. Columns: gx gy gz | rms pk | jitter | gz pk | roll ctx | samples/s | state");
}

// A gyro that stops delivering leaves the last state frozen on screen — a stale face is
// worse than an error, because it looks like a feeling. Nothing in the sample data can
// reveal this (a wedged sensor reads as perfectly still), so the only test is whether new
// samples are arriving at all. Recovery is attempted forever rather than halting: the fault
// is usually a jostled wire, and the car should come back by itself when it is reseated.
static void gyroWatchdog(int n, uint32_t now) {
  static uint32_t lastSample = 0, lastRetry = 0;
  static bool lost = false;

  if (n > 0) {
    lastSample = now;
    if (lost) {                                  // it came back
      lost = false;
      Serial.println("! gyro recovered");
      animShow(motionGet().state);
    }
    return;
  }
  if (!lastSample) lastSample = now;             // first loop, nothing has arrived yet
  if (!lost && now - lastSample > GYRO_TIMEOUT_MS) {
    lost = true; lastRetry = now;
    Serial.println("! gyro stopped delivering samples — check wiring (SDA 8 / SCL 9)");
    animMessage("GYRO ERROR", "no data", "check wiring");
  }
  if (lost && now - lastRetry >= GYRO_RETRY_MS) {
    lastRetry = now;
    uint8_t who;
    if (gyroBegin(who) == GYRO_OK) { gyroFifoEnable(); Serial.println("re-init ok, waiting for samples"); }
    else Serial.printf("re-init failed (WHO_AM_I 0x%02X)\n", who);
  }
}

void loop() {
  static uint32_t lastPrint = 0;

  GyroRaw fifo[21]; bool overrun;
  int n = gyroReadFifo(fifo, 21, overrun);
  if (overrun) Serial.println("! FIFO overrun — loop too slow, samples lost");
  gyroWatchdog(n, millis());
  for (int i = 0; i < n; i++)
    if (motionUpdate(fifo[i])) {
      Serial.printf(">>> state = %s\n", carStateName(motionGet().state));
      animShow(motionGet().state);
    }
  motionTick();
  animTick();
  netPoll();

  if (PRINT_MS && millis() - lastPrint >= PRINT_MS) { lastPrint = millis(); printTelemetry(motionGet()); }
}
